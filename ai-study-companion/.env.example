# ==============================================================
# AI Study Companion — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ==============================================================

# --- Database ---
POSTGRES_USER=asc_user
POSTGRES_PASSWORD=asc_password
POSTGRES_DB=asc_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Application ---
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Google AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSIONS=3072

# --- Admin Provisioning ---
# Set this to the email of the user you want to be admin.
# On app startup, if this user exists, their role is set to admin.
# This is the ONLY way to create the first admin.
ADMIN_EMAIL=admin@example.com

# --- Storage ---
# STORAGE_BACKEND=local  (local filesystem, for development)
# STORAGE_BACKEND=s3     (AWS S3, for production)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# S3 settings (only needed if STORAGE_BACKEND=s3)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- AI Configuration ---
# Similarity threshold below which evidence is "insufficient"
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65
# Top-K chunks to retrieve per Tutor query
RETRIEVAL_TOP_K=5
# Max recent messages to include in Tutor context
TUTOR_CONTEXT_MESSAGES=6
# Default quiz session length
DEFAULT_QUIZ_LENGTH=10
# Mastery update alpha (evidence weight)
MASTERY_ALPHA=0.3
