# ==============================================================
# AI Study Companion — Frontend Environment Variables
# Copy this file to `.env` in the `frontend/` folder
# ==============================================================

# API Base URL for backend requests
# Default for dev proxy: /api/v1
# Default for direct CORS: http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Backend Target URL for Vite Dev Server Proxy
VITE_BACKEND_URL=https://ai-study-companion-c0uj.onrender.com

# Frontend Dev Server Port
VITE_PORT=3000
